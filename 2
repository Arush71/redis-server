package storage

import (
	"fmt"
	"slices"
	"time"

	"github.com/Arush71/redis-server/internal/helpers"
	"github.com/Arush71/redis-server/internal/models"
)

var emptyStreamRange = []StreamEntry{}

func (s *Storage) XADD(streamKey string, id string, values [][]byte) (string, error) {
	timeID, seqID, err := helpers.ParseStreamID(id)
	if err != nil {
		return "", err
	}
	newStreamStorage := make(streamStorageType, 0, len(values)/2)
	for i := 0; i < len(values); i += 2 {
		newStreamStorage = append(newStreamStorage, fieldValue{
			Field: string(values[i]),
			Value: values[i+1],
		})
	}
	newStreamID := models.StreamID{}
	if timeID == nil && seqID == nil {
		newStreamID.Time = uint64(time.Now().UnixMilli())
	} else {
		newStreamID.Time = *timeID
	}
	if seqID == nil {
		if newStreamID.Time != 0 {
			newStreamID.Seq = 0
		} else {
			newStreamID.Seq = 1
		}
	} else {
		newStreamID.Seq = *seqID
	}
	newEntry := StreamEntry{
		Id:            newStreamID,
		StreamStorage: newStreamStorage,
	}
	s.mu.Lock()
	defer s.mu.Unlock()
	it, ok := s.storage[streamKey]
	if ok {
		stream, ok := it.value.(Stream)
		if !ok {
			return "", helpers.ErrWrongType
		}
		if len(stream.value) > 0 {
			lastID := stream.value[len(stream.value)-1].Id
			if timeID == nil && lastID.Time > newEntry.Id.Time {
				newEntry.Id.Time = lastID.Time
			}

			if seqID == nil {
				if lastID.Time == newEntry.Id.Time {
					newEntry.Id.Seq = lastID.Seq + 1
				}
			}
			if lastID.Time > newEntry.Id.Time || (lastID.Time == newEntry.Id.Time && lastID.Seq >= newEntry.Id.Seq) {
				return "", helpers.ErrInvalidIdAppend
			}
		}
		stream.value = append(stream.value, newEntry)
		it.value = stream
		s.storage[streamKey] = it
		return fmt.Sprintf("%d-%d", newEntry.Id.Time, newEntry.Id.Seq), nil
	}
	streamEntries := make([]StreamEntry, 1)
	streamEntries[0] = newEntry
	s.storage[streamKey] = item{
		expiresAt: nil,
		value:     Stream{value: streamEntries},
	}
	return fmt.Sprintf("%d-%d", newEntry.Id.Time, newEntry.Id.Seq), nil
}

func compareIDs(entry StreamEntry, targetID models.StreamID) int {
	if entry.Id.Time != targetID.Time {
		if entry.Id.Time < targetID.Time {
			return -1
		}
		return 1
	}
	if entry.Id.Seq != targetID.Seq {
		if entry.Id.Seq < targetID.Seq {
			return -1
		}
		return 1
	}
	return 0
}

func (s *Storage) XRANGE(streamKey string, startS string, endS string) ([]StreamEntry, error) {
	start, end, err := helpers.ParseStreamIDsRange(startS, endS)
	if err != nil {
		return nil, err
	}
	if start.Time > end.Time {
		return emptyStreamRange, nil
	}
	s.mu.Lock()
	defer s.mu.Unlock()
	it, ok := s.storage[streamKey]
	if !ok {
		return emptyStreamRange, nil
	}
	stream, ok := it.value.(Stream)
	if !ok {
		return nil, helpers.ErrWrongType
	}
	startRange, _ := slices.BinarySearchFunc(stream.value, *start, compareIDs)
	if startRange == len(stream.value) {
		return emptyStreamRange, nil
	}
	endRange, ok := slices.BinarySearchFunc(stream.value[startRange:], *end, compareIDs)
	endRange += startRange
	if ok {
		endRange++
	}
	ranges := stream.value[startRange:endRange]
	if len(ranges) == 0 {
		return emptyStreamRange, nil
	}
	// NOTE: It's safe to return the slice without copying, because of it being a append only slice with no mutation to data.
	return ranges, nil
}

type StreamReadResults struct {
	StreamKey     string
	StreamEntries []StreamEntry
}

func (s *Storage) XREAD(streamKey string, streamID string) ([]StreamEntry, error) {
	timeID, seqID, err := helpers.ParseStreamID(streamID)
	if err != nil {
		return nil, err
	}
	if timeID == nil || seqID == nil {
		return nil, helpers.ErrStreamIdParse
	}
	ID := models.StreamID{Time: *timeID, Seq: *seqID}
	s.mu.Lock()
	defer s.mu.Unlock()
	it, ok := s.storage[streamKey]
	if !ok {
		return emptyStreamRange, nil
	}
	stream, ok := it.value.(Stream)
	if !ok {
		return nil, helpers.ErrWrongType
	}
	startRange, ok := slices.BinarySearchFunc(stream.value, ID, compareIDs)
	if ok {
		startRange++
	}
	if startRange >= len(stream.value) {
		return emptyStreamRange, nil
	}
	ranges := stream.value[startRange:]
	result := make([]StreamReadResults, 0)
	// NOTE: It's safe to return the slice without copying, because of it being a append only slice with no mutation to data.
	return ranges, nil
}
